erDiagram
    account_holder {
        uuid id PK
        varchar type
        varchar name
        varchar phone UK
        varchar email
        varchar verification_level FK
        varchar status
        varchar shop_name
        decimal commission_rate
        timestamptz created_at
    }
    staff_user {
        uuid id PK
        varchar name
        varchar email UK
        varchar role
    }
    verification_request {
        uuid id PK
        uuid account_holder_id FK
        varchar document_ref
        varchar status
        uuid reviewed_by FK
        timestamptz reviewed_at
        timestamptz created_at
    }
    limit_policy {
        varchar verification_level PK
        decimal single_limit
        decimal daily_limit
    }
    account_block {
        uuid id PK
        uuid account_holder_id FK
        varchar reason_code
        timestamptz blocked_from
        timestamptz blocked_until
        uuid created_by
    }

    wallet {
        uuid id PK
        uuid account_holder_id FK
        varchar holder_type FK
        uuid biller_id FK
        varchar wallet_type
        varchar currency
        timestamptz created_at
    }
    wallet_balance {
        uuid wallet_id PK
        decimal available
        decimal held
    }
    ledger_entry {
        uuid id PK
        uuid wallet_id FK
        uuid payment_id FK
        uuid topup_id FK
        uuid posting_id
        varchar entry_type
        decimal available_delta
        decimal held_delta
        varchar reason_code
        uuid correlation_id
        uuid actor_id
        timestamptz created_at
    }
    audit_log {
        uuid id PK
        varchar audit_type
        uuid actor_id
        varchar actor_type
        varchar action
        varchar reason_code
        uuid correlation_id
        uuid ledger_entry_id FK
        varchar entity_type
        uuid entity_id
        jsonb before_state
        jsonb after_state
        jsonb details
        timestamptz created_at
    }

    topup {
        uuid id PK
        varchar reference UK
        uuid account_holder_id FK
        varchar customer_type FK
        uuid agent_id FK
        varchar agent_type FK
        varchar channel
        decimal amount
        varchar status
        timestamptz created_at
    }

    biller {
        uuid id PK
        varchar code UK
        varchar name
        varchar protocol
        varchar adapter_key
        varchar status
        int timeout_seconds
        jsonb config
        timestamptz created_at
        timestamptz updated_at
    }
    biller_service {
        uuid id PK
        uuid biller_id FK
        varchar code
        varchar name
        varchar category
        jsonb required_fields
        varchar status
    }
    fee_rule {
        uuid id PK
        uuid biller_service_id FK
        varchar fee_type
        decimal fixed_amount
        decimal percentage
        decimal min_fee
    }
    fee_tier {
        uuid id PK
        uuid fee_rule_id FK
        decimal min_amount
        decimal max_amount
        decimal fee
    }
    promotion {
        uuid id PK
        uuid biller_service_id FK
        uuid biller_id FK
        decimal fee_override
        timestamptz starts_at
        timestamptz ends_at
        boolean active
    }

    inquiry {
        uuid id PK
        uuid account_holder_id FK
        uuid biller_service_id FK
        jsonb input_fields
        decimal amount_due
        decimal service_fee
        decimal total
        jsonb fee_snapshot
        varchar biller_bill_ref
        timestamptz expires_at
        timestamptz created_at
    }
    payment {
        uuid id PK
        varchar reference UK
        uuid correlation_id
        uuid account_holder_id FK
        varchar payer_type FK
        uuid wallet_id FK
        uuid initiated_by_agent_id FK
        varchar agent_type FK
        uuid biller_service_id FK
        uuid inquiry_id FK
        jsonb input_fields
        decimal amount
        decimal service_fee
        decimal total
        uuid fee_rule_id FK
        uuid promotion_id FK
        jsonb fee_snapshot
        decimal commission_rate
        decimal commission_amount
        varchar status
        varchar rejection_reason
        varchar failure_reason
        varchar biller_reference
        int attempt_count
        timestamptz next_retry_at
        int version
        timestamptz created_at
        timestamptz updated_at
    }
    idempotency_record {
        uuid account_holder_id PK, FK
        varchar idempotency_key PK
        uuid payment_id FK
        timestamptz created_at
    }
    payment_transition_rule {
        varchar from_state PK
        varchar to_state PK
    }
    payment_state_history {
        uuid id PK
        uuid payment_id FK
        varchar from_state FK
        varchar to_state FK
        varchar event
        timestamptz created_at
    }
    biller_call_log {
        uuid id PK
        uuid biller_id FK
        uuid payment_id FK
        uuid inquiry_id FK
        varchar operation
        text request_body
        text response_body
        varchar outcome
        int http_status
        int duration_ms
        timestamptz created_at
    }
    biller_callback_log {
        uuid id PK
        uuid biller_id FK
        uuid payment_id FK
        varchar biller_reference
        varchar external_event_id
        varchar callback_status
        varchar dedupe_key
        jsonb payload
        varchar processing_result
        timestamptz received_at
    }
    notification {
        uuid id PK
        uuid payment_id FK
        uuid account_holder_id FK
        varchar channel
        text message
        varchar status
        int attempts
        text last_error
        timestamptz next_attempt_at
        timestamptz sent_at
        timestamptz created_at
    }

    reconciliation_run {
        uuid id PK
        uuid biller_id FK
        date settlement_date
        varchar file_name
        varchar status
        timestamptz started_at
        timestamptz finished_at
    }
    settlement_row {
        uuid id PK
        uuid run_id FK
        varchar biller_reference
        decimal amount
        varchar settlement_status
        uuid matched_payment_id FK
        varchar match_result
    }
    discrepancy {
        uuid id PK
        uuid run_id FK
        uuid settlement_row_id FK
        uuid payment_id FK
        varchar discrepancy_type
        varchar expected
        varchar actual
        varchar status
        uuid resolved_by FK
        timestamptz resolved_at
        timestamptz created_at
    }

    limit_policy |o--o{ account_holder : "limits by level, agents have none"
    account_holder ||--o{ verification_request : submits
    staff_user ||--o{ verification_request : reviews
    account_holder ||--o{ account_block : "blocked by"

    account_holder |o--|| wallet : "owns exactly one"
    biller |o--|| wallet : "exactly one payable wallet per biller"
    biller |o--o{ promotion : "promotion for whole biller"
    fee_rule ||--o{ payment : "fee computed by"
    promotion |o--o{ payment : "applied to"
    wallet ||--o{ ledger_entry : records
    wallet ||--|| wallet_balance : "derived view"
    ledger_entry |o--|| audit_log : "each entry has exactly one audit, admin audits have no entry"
    payment |o--o{ ledger_entry : posts
    topup |o--o{ ledger_entry : "COMPLETED has exactly 2 entries, FAILED has none, deferred trigger"
    account_holder ||--o{ topup : "credited by"
    account_holder |o--o{ topup : "agent cash in"

    biller ||--|{ biller_service : offers
    biller_service ||--|| fee_rule : "priced by"
    fee_rule ||--o{ fee_tier : "has tiers"
    biller_service |o--o{ promotion : "promoted by, or by the whole biller"

    account_holder ||--o{ inquiry : requests
    biller_service ||--o{ inquiry : "quoted for"
    inquiry ||--o{ payment : "confirmed as"
    account_holder ||--o{ payment : pays
    account_holder ||--o{ idempotency_record : submits
    payment ||--|| idempotency_record : "created by key"
    account_holder |o--o{ payment : "agent initiates"
    wallet ||--o{ payment : "debited from"
    biller_service ||--o{ payment : targets
    payment ||--|{ payment_state_history : "state history"
    payment_transition_rule |o--o{ payment_state_history : "legal pair, none for the creation row"
    payment ||--o{ notification : triggers
    account_holder ||--o{ notification : receives

    biller ||--o{ biller_call_log : logs
    payment |o--o{ biller_call_log : calls
    inquiry |o--o{ biller_call_log : calls
    biller ||--o{ biller_callback_log : receives
    payment |o--o{ biller_callback_log : "callbacks for"

    biller ||--o{ reconciliation_run : "settled by"
    reconciliation_run ||--o{ settlement_row : contains
    reconciliation_run ||--o{ discrepancy : reports
    settlement_row |o--o{ discrepancy : "flagged in, none for MISSING_SETTLEMENT"
    payment |o--o{ settlement_row : "matched to"
    payment |o--o{ discrepancy : "subject of"
    staff_user |o--o{ discrepancy : resolves
